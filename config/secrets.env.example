# Example secrets file. Never commit real values.
#
# Install it as:
#   install -m 0600 config/secrets.env.example ~/.config/agent/secrets.env
#
# Then fill in the values locally and source it in your shell, e.g.:
#   set -a; source ~/.config/agent/secrets.env; set +a
#
# .gitignore covers this filename; review `git diff` before committing.

# GitHub CLI / gh auth
GITHUB_TOKEN=

# LLM providers (OpenCode, agents)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=

# Bug-bounty platform tokens (optional)
HACKERONE_API_TOKEN=
BUGCROWD_API_TOKEN=
