# Example only. Copy to ~/.config/oracle-a1-catcher.env (chmod 600).
# systemd user EnvironmentFile syntax. Do NOT commit the populated copy.
OCI_REGION=ap-hyderabad-1
OCI_COMPARTMENT_ID=
OCI_AVAILABILITY_DOMAIN=
OCI_SUBNET_ID=
OCI_IMAGE_ID=
OCI_SSH_PUBLIC_KEY_FILE=/home/msapredator/.ssh/id_ed25519.pub
OCI_DISPLAY_NAME=oracle-a1-free-catcher
OCI_OCPUS=2
OCI_MEMORY_GB=12
# A private IP is safer. For public SSH, lock down NSG/security list FIRST.
OCI_ASSIGN_PUBLIC_IP=false
# Both guards MUST be true before the script may call launch.
OCI_ENABLE_LAUNCH=false
OCI_ACK_ACCOUNT_QUOTA=false
# Optional bot alerts. Never put real tokens into git.
OCI_TELEGRAM_BOT_TOKEN=
OCI_TELEGRAM_CHAT_ID=
